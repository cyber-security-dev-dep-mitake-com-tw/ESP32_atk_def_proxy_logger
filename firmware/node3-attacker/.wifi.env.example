# Copy to .wifi.env and fill in. Sourced by flash-node3.sh at build time.
export WIFI_SSID="YourLabSSID"
export WIFI_PASSWORD="YourWiFiPassword"
# Your own AP's BSSID — the ONLY target Node3 will deauth. Get it from your router
# or `Node1`'s capture. Any other BSSID is refused in firmware.
export OWN_BSSID="aa:bb:cc:dd:ee:ff"
# Backend WebSocket URL. 172.16.200.52 is this PC on en0; change if your LAN differs.
export WS_URL="ws://172.16.200.52:8080/ws/node/node3"
