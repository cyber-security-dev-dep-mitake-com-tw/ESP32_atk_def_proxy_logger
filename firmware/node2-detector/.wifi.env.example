# Copy to .wifi.env and fill in. Sourced by flash-node2.sh at build time.
# Can match node3-attacker/.wifi.env (same lab SSID/password); only WS_URL differs.
export WIFI_SSID="VIP"
export WIFI_PASSWORD="your-password"
# Backend WebSocket URL — must be reachable from the ESP on this WiFi (same LAN).
export WS_URL="ws://172.16.200.60:8080/ws/node/node2"
