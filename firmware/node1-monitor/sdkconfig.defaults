# ESP-IDF config for Node1 on the ESP32-S3 dev board.

# Route the console (stdout/stdin, i.e. our NDJSON stream + commands) over the
# chip's built-in USB Serial/JTAG, which is what enumerates as /dev/cu.usbmodem*.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Larger main task stack: WiFi init + our capture pipeline.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10000

# Bump the promiscuous/WiFi RX buffers so we drop fewer frames at high rates.
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_RX_BA_WIN=16

# 240 MHz for headroom while formatting/encoding frames.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
